# --- required for live usage ---
HELIUS_API_KEY=
DATABASE_URL=postgres://insiderscope:insiderscope@localhost:5432/insiderscope
REDIS_URL=redis://localhost:6379
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Secret Helius sends back in the Authorization header of webhook deliveries.
WEBHOOK_AUTH_HEADER=change-me-random-string
# Public base URL for the ingest webhook endpoint (ngrok/cloudflared in dev).
# Ingest registers ${PUBLIC_BASE_URL}/webhook/helius with Helius.
PUBLIC_BASE_URL=
INGEST_PORT=3001
# On Railway/Heroku-style platforms leave INGEST_PORT unset — the injected PORT is used.
# MIGRATE_ON_BOOT=true         # ingest applies committed migrations at startup (idempotent)
# PUBLIC_BASE_URL auto-derives from RAILWAY_PUBLIC_DOMAIN on Railway when left empty.

# --- tunables (defaults shown; uncomment to override) ---
# EARLY_WINDOW_MIN=30            # early-buyer window after launch (minutes)
# EARLY_MAX_BUYERS=150           # stop collecting new early buyers after this many
# TRANSFER_MIN_SOL=5             # min SOL out-transfer to trigger rotation tracking
# SELL_ALERTS=true               # send 📉 SELL alerts
# PROBATION_EXPIRY_DAYS=14       # deactivate probation wallets with no trades after N days
# MAX_CHILDREN_PER_PARENT=3      # max rotation children tracked per parent wallet
# MIN_SCORED_POSITIONS=3         # early positions required before "insider" tier is allowed
# ALERT_DEBOUNCE_SEC=10          # per wallet+mint+kind alert debounce
# ALERT_MAX_AGE_MIN=15           # never alert on events older than this
# RECONCILE_INTERVAL_MIN=5       # webhook-gap backfill interval
# HELIUS_CONCURRENCY=5           # parallel Helius requests
# HELIUS_RPS=10                  # requests/second ceiling — match your Helius plan
# FUNDING_MAX_PAGES=8            # page cap for funding-graph crawls
# HELIUS_MAX_PAGES_TOKEN=300     # page cap when draining token (curve/pool) history
# HELIUS_MAX_PAGES_WALLET=20     # page cap when draining a wallet's swap history
# FUNDING_MAX_FUNDERS=10         # 2nd-hop funders crawled per wallet in funding graph
# FUNDING_LOOKBACK_DAYS=30       # days before launch included in the funding crawl window
# TOKENS_DIR=/data/tokens        # *.csv candidate lists re-imported on every pipeline pass
# SCORE_MAX_TRADES=500           # lifetime swaps above this = bot, auto-blacklisted
# SCORE_REFRESH_DAYS=3           # rescore cadence for wallets with no new activity
# CONFLUENCE_MIN_WALLETS=2       # watched wallets buying the same mint...
# CONFLUENCE_WINDOW_MIN=60       # ...within this many minutes → 🔥 combined alert
# DEV_ALERTS=true                # 🧨 alert when a known $10M creator/insider launches a token
# DIGEST_ENABLED=true            # 📊 daily 09:00 UTC summary message
# SCORE_SELECTIVITY_TRADES=200   # trade count where the selectivity factor hits zero
# PUMPPORTAL_ENABLED=true        # subscribe to pump.fun launch stream
# TRACK_GRADUATIONS=true         # record pump.fun bonding-curve completions as future candidates
# WATCH_FLOOR=12                 # min live watch-list size — best unranked wallets promoted to fill it (0 = off)
# DISCOVER_MIN_MC_USD=10000000   # candidate threshold used by `analyzer discover`
# RECENT_MIN_MC_USD=5000000      # lower bar for tokens that peaked inside the recency window (crawled FIRST)
# RECENT_WINDOW_DAYS=14          # the "last 1-2 weeks" recency window
# SOL_PRICE_FALLBACK_USD=        # used only when Binance klines are unreachable
